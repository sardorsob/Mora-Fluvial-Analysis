# Local environments and generated development files.
.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.pytest_cache/
.ruff_cache/
.env
.env.*
!.env.example
*.pem
*.key

# Full field data remains local; preserve the directory layout in Git.
/salt-dilution/data/raw/*
!/salt-dilution/data/raw/.gitkeep
/salt-dilution/data/processed/*
!/salt-dilution/data/processed/.gitkeep
/fluvial-seismology/data/raw/*
!/fluvial-seismology/data/raw/.gitkeep
/fluvial-seismology/data/processed/*
!/fluvial-seismology/data/processed/.gitkeep

# Keep the run instructions and template, not generated runs.
/salt-dilution/results/*
!/salt-dilution/results/README.md
!/salt-dilution/results/_template/
/fluvial-seismology/results/*
!/fluvial-seismology/results/README.md
!/fluvial-seismology/results/_template/
