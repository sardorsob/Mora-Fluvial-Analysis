# Local environments and generated development files.
.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.pytest_cache/
.ruff_cache/
.env
.env.*
!.env.example
*.pem
*.key

# Full field data remains local; preserve the directory layout in Git.
/fluvial_seismology/data/raw/*
!/fluvial_seismology/data/raw/.gitkeep
/fluvial_seismology/data/processed/*
!/fluvial_seismology/data/processed/.gitkeep

# Keep the run instructions and template, not generated runs.
/fluvial_seismology/results/*
!/fluvial_seismology/results/README.md
!/fluvial_seismology/results/_template/
