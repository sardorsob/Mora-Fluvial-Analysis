# Auto detect text files and perform LF normalization
* text=auto

# Preserve source bytes so recorded checksums survive every checkout platform.
salt_dilution/data/raw/** -text -whitespace
salt_dilution/data/examples/*.csv -text -whitespace
docs/source_notes/*.txt -text -whitespace

# Curated record checksums must not depend on the checkout platform.
salt_dilution/data/records/*.csv text eol=lf
salt_dilution/data/records/*.json text eol=lf

# Saved pairing checksums describe exact output bytes on every platform.
salt_dilution/results/matching/2026-10-31_final_pairings/* -text -whitespace
salt_dilution/results/matching/2026-11-01_source_linked_pairings/* -text -whitespace
salt_dilution/results/matching/2026-11-01_reviewed_pairings/* -text -whitespace

# Preserve the discharge analysis bytes across checkout platforms.
salt_dilution/results/discharge_analysis/** -text -whitespace
salt_dilution/results/discharge_scenarios/** -text -whitespace
